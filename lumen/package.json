{
  "name": "lumen-agent",
  "version": "0.1.0",
  "description": "Lumen: a bring-your-own-keys terminal agent with a local creative dashboard, multi-chain crypto tools, media generation and on-screen \"show me\".",
  "type": "module",
  "license": "MIT",
  "bin": {
    "lumen": "bin/lumen.js"
  },
  "main": "src/index.js",
  "lumen": {
    "id": "lumen-terminal-agent"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "bin",
    "src",
    "native",
    "personas",
    "skills",
    "dashboard/dist",
    "README.md",
    "LICENSE",
    "assets"
  ],
  "scripts": {
    "start": "node bin/lumen.js",
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test \"test/*.test.js\"",
    "replit": "node scripts/replit.mjs",
    "assets": "node scripts/render-assets.mjs",
    "typecheck": "npm --prefix dashboard run typecheck"
  },
  "keywords": [
    "agent",
    "cli",
    "tui",
    "llm",
    "crypto",
    "evm",
    "solana",
    "chainlink",
    "media",
    "dashboard"
  ],
  "dependencies": {
    "@useclaudia/media": "^0.3.0",
    "@useclaudia/sdk": "^0.3.0",
    "@useclaudia/social": "^0.3.0",
    "viem": "^2.57.5",
    "ws": "^8.22.0"
  },
  "author": "Claudia <339291616+claudia-onchain@users.noreply.github.com> (https://useclaudia.xyz)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/claudia-onchain/harness.git",
    "directory": "lumen"
  },
  "homepage": "https://github.com/claudia-onchain/harness/tree/main/lumen#readme",
  "bugs": {
    "url": "https://github.com/claudia-onchain/harness/issues"
  }
}
